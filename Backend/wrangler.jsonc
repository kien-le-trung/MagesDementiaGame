{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mages-approach-judge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "*"
  },
  "secrets": {
    "required": ["OPENROUTER_API_KEY"]
  }
}
